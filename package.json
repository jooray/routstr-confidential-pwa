{
  "name": "routstr-confidential-pwa",
  "private": true,
  "version": "0.1.5",
  "description": "Confidential chat PWA for routstr nodes (confidential mode v2, verified in the browser)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/ensure-lib.mjs && tsc --noEmit -p . && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "link-local": "npm install --no-save ../routstr-confidential-web",
    "test:e2e": "node scripts/e2e-prod.mjs smoke"
  },
  "dependencies": {
    "@routstr/confidential-web": "github:jooray/routstr-confidential-web#cd9675dcf2735fc03d3a314340f3a18d20aa4c76",
    "dompurify": "^3.4.16",
    "markdown-it": "^14.3.2",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
